; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KINGPIN"
config/description="A pinball racket. Points are money. The table is your career."
config/version="0.5.0-beta.1"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/version_code=5

[autoload]

Events="*res://game/core/events.gd"
Feel="*res://game/core/feel.gd"
Balls="*res://game/core/ball_registry.gd"
AudioDirector="*res://game/audio/audio_director.gd"
Game="*res://game/flow/game.gd"
Presentation="*res://game/presentation/presentation.gd"
Telemetry="*res://game/telemetry/telemetry.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[layer_names]

3d_physics/layer_1="walls"
3d_physics/layer_2="ball"
3d_physics/layer_3="flippers"
3d_physics/layer_4="hardware"
3d_physics/layer_5="zones"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=240
3d/default_gravity=98.1
common/physics_interpolation=true
jolt_physics_3d/simulation/bounce_velocity_threshold=0.3
jolt_physics_3d/simulation/penetration_slop=0.004
jolt_physics_3d/simulation/speculative_contact_distance=0.02

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0705882, 0.0627451, 0.054902, 1)
